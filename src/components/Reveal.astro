---
// A grid of drag-to-compare sliders: two versions of the same image, e.g. lighting only vs final render.
// Both versions use the same file name in two folders under src/assets/work/<set>/.
// MDX: <Reveal set="private-jet" before="clay" after="stills" items={stills} lead />
import { workImage, responsive, GRIDS, LEAD } from '../lib/images';

interface Props {
  set: string;
  /** Folder of the "before" images (left side). */
  before: string;
  /** Folder of the "after" images (right side). */
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
  items: { file: string; title: string }[];
  /** Show the first slider across the full width. */
  lead?: boolean;
}

const { set, before, after, beforeLabel = 'Before', afterLabel = 'After', items, lead = false } = Astro.props;
const layout = GRIDS[2];

const pairs = await Promise.all(
  items.map(async (item, i) => {
    const a = workImage(`${set}/${before}`, item.file);
    const b = workImage(`${set}/${after}`, item.file);
    const wide = lead && i === 0;
    const widths = wide ? LEAD.widths : [...layout.widths];
    const [left, right] = await Promise.all([responsive(a, widths), responsive(b, widths)]);
    return { ...item, wide, left, right, ratio: `${b.width} / ${b.height}`, sizes: wide ? LEAD.sizes : layout.sizes };
  }),
);
---

<div class:list={['not-prose my-12 grid w-[100cqw] gap-x-5 gap-y-8', layout.grid]}>
  {
    pairs.map((p) => (
      <figure class:list={[p.wide && 'col-span-full']}>
        <div
          class="relative overflow-hidden rounded-xl border border-line bg-surface select-none"
          style={`aspect-ratio: ${p.ratio}; --pos: 50%`}
          data-reveal
        >
          {[
            { img: p.left, label: beforeLabel, clip: undefined },
            { img: p.right, label: afterLabel, clip: 'clip-path: inset(0 0 0 var(--pos))' },
          ].map((side) => (
            <picture class="contents">
              <source type="image/avif" srcset={side.img.avif} sizes={p.sizes} />
              <source type="image/webp" srcset={side.img.webp} sizes={p.sizes} />
              <img
                src={side.img.fallback}
                alt={`${p.title}, ${side.label.toLowerCase()}`}
                width={side.img.width}
                height={side.img.height}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="absolute inset-0 h-full w-full object-cover"
                style={side.clip}
              />
            </picture>
          ))}
          <div class="pointer-events-none absolute inset-y-0 w-px bg-ink" style="left: var(--pos)">
            <span class="absolute top-1/2 left-1/2 grid size-9 -translate-1/2 place-items-center rounded-full border border-ink/60 bg-bg/70 text-xs backdrop-blur">
              ⟷
            </span>
          </div>
          <span class="pointer-events-none absolute top-3 left-3 rounded-full bg-bg/70 px-2.5 py-1 text-xs text-ink">{beforeLabel}</span>
          <span class="pointer-events-none absolute top-3 right-3 rounded-full bg-bg/70 px-2.5 py-1 text-xs text-ink">{afterLabel}</span>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label={`${p.title}: compare ${beforeLabel.toLowerCase()} and ${afterLabel.toLowerCase()}`}
            class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
          />
        </div>
        <figcaption class="mt-3 text-sm leading-6 font-medium text-ink">{p.title}</figcaption>
      </figure>
    ))
  }
</div>

<script>
  document.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const frame = input.closest?.<HTMLElement>('[data-reveal]');
    if (frame) frame.style.setProperty('--pos', `${input.value}%`);
  });
</script>
