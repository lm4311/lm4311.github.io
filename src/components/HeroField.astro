---
// Hero background: a room-scale floor of points seen in perspective, like the
// guardian grid in a headset. The cursor acts as a hand/gaze: points rise and
// light up beneath it, a ring follows it on the floor, and the whole plane
// turns slightly with it. Plain canvas, no libraries.
---

<canvas class="absolute inset-0 h-full w-full" data-field aria-hidden="true"></canvas>

<script>
  type Stop = () => void;
  let stop: Stop | null = null;

  const ACCENT = [98, 230, 211];
  const INK = [242, 240, 236];

  function start(root: HTMLElement): Stop {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-field]')!;
    const copy = root.querySelector<HTMLElement>('[data-hero-copy]');
    const ctx = canvas.getContext('2d')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Floor points in world space: x across, z away from the camera. Rows get
    // farther apart with depth so the spacing reads evenly in perspective.
    const Z0 = 1.15;
    const Z1 = 14;
    const XSTEP = 0.12;
    const points: [number, number][] = [];
    for (let z = Z0; z <= Z1; z *= 1.065) {
      const half = 1.1 * z + 1.2; // a little wider than the view, for the turn
      for (let x = -half; x <= half; x += XSTEP) points.push([x, z]);
    }
    const H = 1.3; // camera height above the floor
    const ZC = 5; // the plane turns around this depth

    let width = 0;
    let height = 0;
    let dpr = 1;
    let f = 1; // focal length in px
    let cx = 0;
    let cy = 0; // horizon line

    // Pointer state, smoothed. `target` is in normalized -1..1 hero space.
    const target = { x: 0.35, y: 0.35, inside: false };
    const pose = { x: 0.35, y: 0.35, yaw: 0, glow: 0 };
    const hit = { x: 0, z: 4, ok: false };

    function resize() {
      const r = root.getBoundingClientRect();
      width = r.width;
      height = r.height;
      dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      f = height * 0.9;
      cx = width * 0.5;
      cy = height * 0.12;
      if (reduced) draw(0);
    }

    function onMove(e: PointerEvent) {
      const r = root.getBoundingClientRect();
      target.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      target.y = ((e.clientY - r.top) / r.height) * 2 - 1;
      target.inside = e.pointerType === 'mouse';
    }
    function onLeave() {
      target.inside = false;
    }

    /** Casts a ray from the camera through a screen point onto the turned floor plane. */
    function castToFloor(sx: number, sy: number, cos: number, sin: number) {
      const dy = (sy - cy) / f;
      if (dy <= 0.02) return false;
      const t = H / dy;
      const wx = ((sx - cx) / f) * t;
      const wz = t;
      // Undo the plane's turn around (0, ZC).
      const rx = wx * cos + (wz - ZC) * sin;
      const rz = -wx * sin + (wz - ZC) * cos + ZC;
      hit.x = rx;
      hit.z = rz;
      return true;
    }

    function draw(time: number) {
      // Ease toward the pointer; drift slowly when there is no mouse.
      const idle = !target.inside;
      const tx = idle ? 0.35 + Math.sin(time * 0.00025) * 0.35 : target.x;
      const ty = idle ? 0.4 + Math.sin(time * 0.00019) * 0.25 : target.y;
      const k = reduced ? 1 : 0.08;
      pose.x += (tx - pose.x) * k;
      pose.y += (ty - pose.y) * k;
      pose.yaw += (pose.x * 0.07 - pose.yaw) * k;
      pose.glow += ((target.inside ? 1 : 0.55) - pose.glow) * 0.05;

      const cos = Math.cos(pose.yaw);
      const sin = Math.sin(pose.yaw);
      hit.ok = castToFloor(((pose.x + 1) / 2) * width, ((pose.y + 1) / 2) * height, cos, sin);

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      // Faint horizon where the floor meets the room.
      const horizon = ctx.createLinearGradient(0, 0, width, 0);
      horizon.addColorStop(0, 'rgba(98,230,211,0)');
      horizon.addColorStop(0.65, 'rgba(98,230,211,0.22)');
      horizon.addColorStop(1, 'rgba(98,230,211,0)');
      ctx.fillStyle = horizon;
      ctx.fillRect(0, cy + 6, width, 1);

      // Soft light pooling under the hand.
      if (hit.ok) {
        const hx = ((pose.x + 1) / 2) * width;
        const hy = ((pose.y + 1) / 2) * height;
        const glow = ctx.createRadialGradient(hx, hy, 0, hx, hy, Math.max(width, height) * 0.28);
        glow.addColorStop(0, `rgba(98,230,211,${(0.09 * pose.glow).toFixed(3)})`);
        glow.addColorStop(1, 'rgba(98,230,211,0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, width, height);
      }

      // Sizes scale with depth so the effect looks the same size on screen wherever the hand is.
      const R = 0.2 * hit.z;
      for (const [x, z] of points) {
        // Lift and light the floor near the hand.
        let near = 0;
        if (hit.ok) {
          const dx = x - hit.x;
          const dz = z - hit.z;
          near = Math.exp(-(dx * dx + dz * dz) / (R * R)) * pose.glow;
        }
        const lift = near * 0.055 * hit.z;
        // Turn the plane, then project.
        const px = x * cos - (z - ZC) * sin;
        const pz = x * sin + (z - ZC) * cos + ZC;
        if (pz < 0.5) continue;
        const sx = cx + (f * px) / pz;
        const sy = cy + (f * (H - lift)) / pz;
        if (sx < -4 || sx > width + 4 || sy < -4 || sy > height + 4) continue;

        const depth = Math.max(0, 1 - (pz - Z0) / (Z1 - Z0));
        const a = 0.12 + depth * 0.3 + near * 0.7;
        const c = near > 0.02 ? mix(INK, ACCENT, Math.min(1, near * 1.6)) : INK;
        const s = Math.max(0.8, Math.min(2.4, (2.6 / pz) * (1 + near * 0.8)));
        ctx.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${a.toFixed(3)})`;
        ctx.fillRect(sx - s / 2, sy - s / 2, s, s);
      }

      // Gaze ring on the floor, drawn in perspective.
      if (hit.ok) {
        ctx.beginPath();
        for (let i = 0; i <= 48; i++) {
          const ang = (i / 48) * Math.PI * 2;
          const x = hit.x + Math.cos(ang) * 0.05 * hit.z;
          const z = hit.z + Math.sin(ang) * 0.05 * hit.z;
          const px = x * cos - (z - ZC) * sin;
          const pz = x * sin + (z - ZC) * cos + ZC;
          const sx = cx + (f * px) / pz;
          const sy = cy + (f * H) / pz;
          if (i === 0) ctx.moveTo(sx, sy);
          else ctx.lineTo(sx, sy);
        }
        ctx.strokeStyle = `rgba(${ACCENT[0]},${ACCENT[1]},${ACCENT[2]},${(0.55 * pose.glow).toFixed(3)})`;
        ctx.lineWidth = 1.25;
        ctx.stroke();
      }

      // The headline sits a little closer than the floor, so it moves less.
      if (copy && !reduced) copy.style.transform = `translate3d(${(-pose.x * 8).toFixed(2)}px, ${(-pose.y * 5).toFixed(2)}px, 0)`;
    }

    function mix(a: number[], b: number[], t: number) {
      return [0, 1, 2].map((i) => Math.round(a[i] + (b[i] - a[i]) * t));
    }

    let raf = 0;
    let running = false;
    const loop = (t: number) => {
      draw(t);
      raf = requestAnimationFrame(loop);
    };
    const setRunning = (on: boolean) => {
      if (reduced || on === running) return;
      running = on;
      if (on) raf = requestAnimationFrame(loop);
      else cancelAnimationFrame(raf);
    };

    const ro = new ResizeObserver(resize);
    ro.observe(root);
    resize();
    const io = new IntersectionObserver(([entry]) => setRunning(entry.isIntersecting));
    io.observe(root);
    root.addEventListener('pointermove', onMove);
    root.addEventListener('pointerleave', onLeave);

    return () => {
      setRunning(false);
      ro.disconnect();
      io.disconnect();
      root.removeEventListener('pointermove', onMove);
      root.removeEventListener('pointerleave', onLeave);
    };
  }

  document.addEventListener('astro:page-load', () => {
    stop?.();
    stop = null;
    const root = document.querySelector<HTMLElement>('[data-hero-field]');
    if (root) stop = start(root);
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>
