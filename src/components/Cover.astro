---
// Project media: looping video if provided, else poster image, else a generated studio render.
import { coverScene, COVER_TOP, COVER_BOTTOM, type Motif } from '../lib/cover';

interface Props {
  seed: string;
  accent: string;
  motif?: Motif;
  video?: string;
  poster?: string;
  alt?: string;
  class?: string;
  /** Autoplay the loop (case-study header). Cards play on hover instead. */
  autoplay?: boolean;
  /** Untextured "clay render" look for the generated cover. */
  clay?: boolean;
  /** Show the browser's video controls (project pages). */
  controls?: boolean;
  /** With autoplay: load and play the loop only while it is on screen (case-study clips). Give it a poster. */
  lazy?: boolean;
}

const {
  seed,
  accent,
  motif,
  video,
  poster,
  alt = '',
  class: className = '',
  autoplay = false,
  clay = false,
  controls = false,
  lazy = false,
} = Astro.props;
const inView = autoplay && lazy;
// A video's own `poster` is fetched as soon as the page opens, wherever the video is. Only the video at the top of
// a page should cost that. Every other clip (cards, case-study clips) keeps its still as an ordinary image under
// the video instead, which the browser fetches only when the reader gets near it. A video with nothing loaded is
// see-through, so the still shows until the first frame covers it.
const posterNow = autoplay && !inView;
const id = `c${seed.replace(/[^a-z0-9]/gi, '').toLowerCase()}${clay ? 'clay' : ''}`;
const prims = coverScene(seed, clay ? '#bbbbbb' : accent, motif);
const blurs = [...new Set(prims.map((p) => p.blur).filter((b): b is number => !!b))];
const fid = (b: number) => `${id}-b${String(b).replace('.', '_')}`;
---

<div class:list={['isolate overflow-hidden bg-surface', !/\babsolute\b/.test(className) && 'relative', className]}>
  {
    video ? (
      <Fragment>
        {poster && !posterNow && (
          <img class="absolute inset-0 h-full w-full object-cover" src={poster} alt="" loading="lazy" decoding="async" />
        )}
        <video
          class="absolute inset-0 h-full w-full object-cover"
          src={video}
          poster={posterNow ? poster : undefined}
          muted
          loop
          playsinline
          preload={autoplay && !inView ? 'auto' : 'none'}
          autoplay={autoplay && !inView}
          controls={controls}
          data-hover-play={!autoplay}
          data-inview-play={inView ? '' : undefined}
          aria-hidden={controls ? undefined : 'true'}
        />
      </Fragment>
    ) : poster ? (
      <img class="absolute inset-0 h-full w-full object-cover" src={poster} alt={alt} loading="lazy" />
    ) : (
      <svg
        class:list={['absolute inset-0 h-full w-full', clay && 'grayscale']}
        viewBox="0 0 160 90"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color={clay ? '#2a2b2e' : COVER_TOP} />
            <stop offset="1" stop-color={clay ? '#141416' : COVER_BOTTOM} />
          </linearGradient>
          {prims.map((p, i) =>
            p.t === 'hglow' ? (
              <linearGradient id={`${id}-h${i}`} x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" style={`stop-color:${p.color};stop-opacity:0`} />
                <stop offset="0.5" style={`stop-color:${p.color}`} />
                <stop offset="1" style={`stop-color:${p.color};stop-opacity:0`} />
              </linearGradient>
            ) : null,
          )}
          {blurs.map((b) => (
            <filter id={fid(b)} x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation={b} />
            </filter>
          ))}
        </defs>
        <rect x="-100" y="-100" width="360" height="290" fill={`url(#${id}-bg)`} />
        {prims.map((p, i) => {
          const filter = p.blur ? `url(#${fid(p.blur)})` : undefined;
          // Colors go through style so CSS variables (e.g. var(--color-accent)) work.
          if (p.t === 'rect') return <rect x={p.x} y={p.y} width={p.w} height={p.h} style={`fill:${p.fill}`} opacity={p.o} filter={filter} />;
          if (p.t === 'hglow') return <rect x="0" y={p.y - p.h / 2} width="160" height={p.h} fill={`url(#${id}-h${i})`} opacity={p.o} filter={filter} />;
          const paint = `fill:${'fill' in p && p.fill ? p.fill : 'none'};stroke:${p.stroke ?? 'none'}`;
          if (p.t === 'circle') return <circle cx={p.x} cy={p.y} r={p.r} style={paint} stroke-width={p.sw} opacity={p.o} filter={filter} />;
          const points = p.pts.map(([x, y]) => `${x},${y}`).join(' ');
          return p.closed ? (
            <polygon points={points} style={paint} stroke-width={p.sw} opacity={p.o} filter={filter} />
          ) : (
            <polyline points={points} style={paint} stroke-width={p.sw} stroke-linejoin="round" opacity={p.o} filter={filter} />
          );
        })}
      </svg>
    )
  }
</div>
