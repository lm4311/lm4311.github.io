---
// System architecture as a left-to-right flow of steps (wraps on small screens).
// MDX: <Pipeline caption="Data flow" steps={[{ title: 'Motive', detail: 'Tracks rigid bodies' }, …]} />
interface Props {
  steps: { title: string; detail?: string }[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<figure class="breakout not-prose">
  <ol class="my-0 flex list-none flex-col items-stretch gap-2 rounded-2xl border border-line p-4 sm:p-6 lg:flex-row lg:items-stretch">
    {
      steps.map((s, i) => (
        <>
          <li class="flex-1 rounded-xl bg-surface px-4 py-3.5">
            <p class="text-xs text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-1 font-semibold">{s.title}</p>
            {s.detail && <p class="mt-1 text-sm leading-5 text-ink/70">{s.detail}</p>}
          </li>
          {i < steps.length - 1 && (
            <li class="self-center text-accent" aria-hidden="true">
              <span class="lg:hidden">↓</span>
              <span class="hidden lg:inline">→</span>
            </li>
          )}
        </>
      ))
    }
  </ol>
  {caption && <figcaption class="caption mt-3">{caption}</figcaption>}
</figure>
