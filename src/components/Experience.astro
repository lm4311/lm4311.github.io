---
// Project experience (and education, when it is filled in) from src/data/site.ts.
import { experience, education } from '../data/site';
---

<div class:list={['grid gap-12', education.length > 0 && 'lg:grid-cols-[2fr_1fr]']}>
  <div>
    <h3 class="label">Project experience</h3>
    <ol class="mt-3 divide-y divide-line border-y border-line">
      {
        experience.map((e) => (
          <li class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="text-sm text-muted tabular-nums">{e.when}</span>
            <div>
              <p class="font-medium">
                {e.role}{' '}
                <span class="text-muted">
                  ·{' '}
                  {e.href ? (
                    <a href={e.href} class="underline decoration-ink/25 underline-offset-4 hover:text-ink">
                      {e.org}
                    </a>
                  ) : (
                    e.org
                  )}
                </span>
              </p>
              {e.note && <p class="mt-1 max-w-3xl text-[15px] leading-6 text-ink/70">{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  {
    education.length > 0 && (
      <div>
        <h3 class="label">Education</h3>
        <ol class="mt-3 divide-y divide-line border-y border-line">
          {education.map((e) => (
            <li class="py-4">
              <p class="font-medium">{e.degree}</p>
              <p class="mt-1 text-[15px] text-ink/70">
                {e.school} · <span class="tabular-nums">{e.when}</span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</div>
