---
import { skills } from '../data/site';
---

<div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
  {
    skills.map((s) => (
      <div>
        <h3 class="label">{s.group}</h3>
        <ul class="mt-3 space-y-1.5 text-[15px] text-ink/70">
          {s.items.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
