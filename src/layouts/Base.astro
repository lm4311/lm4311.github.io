---
import { ClientRouter } from 'astro:transitions';
// Weight and width axes: small labels use the narrow width.
import '@fontsource-variable/instrument-sans/standard.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#08090a" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <!-- Marks that JavaScript runs, before the first paint: sections may then start dark and be revealed, and the
         homepage's 3D name may stand in for the type. The class is put back after each page change. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const fine = matchMedia('(hover: hover) and (pointer: fine)');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');

      // ---------- The cursor ----------
      // Styles are under "The cursor" in global.css. At rest the browser's own cursor shows. Over links and buttons
      // the site's ring takes its place, and over [data-cursor] pictures a disc with their word.
      const cursor = { x: 0, y: 0, sx: 0, sy: 0, seen: false, inside: false, el: null as HTMLElement | null };
      function mountCursor() {
        if (!fine.matches) return;
        // The page's body is replaced on every page change, so the element is put back each time.
        cursor.el = document.createElement('div');
        cursor.el.className = 'cur';
        cursor.el.setAttribute('aria-hidden', 'true');
        cursor.el.innerHTML = '<i><span></span></i>';
        document.body.append(cursor.el);
        if (cursor.seen) document.documentElement.classList.add('custom-cursor');
      }
      // Give the cursor the shape that suits what is under it, and hide the browser's cursor only while that shape
      // is really on screen. Everything that changes the cursor goes through here.
      function suit(target: Element | null) {
        const el = cursor.el?.isConnected ? cursor.el : null;
        const card = target?.closest('[data-cursor]');
        const link = target?.closest('a, button, summary, input, select, textarea, label, [role="button"], [role="slider"]');
        // An embedded video is another page: the browser's cursor shows inside it, so ours steps aside.
        const away = !cursor.inside || target instanceof HTMLIFrameElement;
        const shape = el && !away ? (card ? 'on-card' : link ? 'on-link' : '') : '';
        if (el) {
          el.classList.toggle('on-card', shape === 'on-card');
          el.classList.toggle('on-link', shape === 'on-link');
          el.classList.toggle('is-away', away);
          const word = card?.getAttribute('data-cursor') ?? '';
          const label = el.querySelector('span')!;
          if (card && label.textContent !== word) label.textContent = word;
        }
        // See html.cursor-shape in global.css.
        document.documentElement.classList.toggle('cursor-shape', shape !== '');
      }

      // ---------- Hover that follows the cursor ----------
      // A browser only updates :hover when the mouse moves, so after a scroll the wrong thing stays hovered.
      // This keeps its own record instead: the element under the cursor and each of its parents carry data-hover,
      // which the hover styles read (see "Hover that follows the cursor" in global.css). Elements entering and
      // leaving that set get a "hover:enter" or "hover:leave" event, and [data-tilt] elements in it lean toward
      // the cursor. It runs after every mouse move, and again whenever the page moves under a still cursor.
      let hovered: Element[] = [];
      let hoverTarget: Element | null = null;
      const tiltFrames = new WeakMap<Element, HTMLElement>();

      // 3D tilt: sets --rx and --ry (degrees) and --px and --py (-0.5 to 0.5) on the element; the CSS does the rest.
      function tilt(el: HTMLElement) {
        let frame = tiltFrames.get(el);
        if (!frame) {
          frame = el.querySelector<HTMLElement>('.card-frame, .portrait-stage, img') ?? el;
          tiltFrames.set(el, frame);
        }
        // data-tilt="14" sets the most the element turns, in degrees (9 by default).
        const most = Number(el.dataset.tilt) || 9;
        const r = frame.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (cursor.x - r.left) / r.width)) - 0.5;
        const y = Math.min(1, Math.max(0, (cursor.y - r.top) / r.height)) - 0.5;
        el.classList.add('is-tilting');
        el.style.setProperty('--ry', `${(x * most).toFixed(2)}deg`);
        el.style.setProperty('--rx', `${(-y * most * 0.78).toFixed(2)}deg`);
        el.style.setProperty('--px', x.toFixed(3));
        el.style.setProperty('--py', y.toFixed(3));
      }
      function untilt(el: HTMLElement) {
        el.classList.remove('is-tilting');
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
        el.style.setProperty('--px', '0');
        el.style.setProperty('--py', '0');
      }

      function hover(target: Element | null) {
        if (target !== hoverTarget || (target && !target.hasAttribute('data-hover'))) {
          hoverTarget = target;
          const next: Element[] = [];
          for (let el = target; el && el !== document.documentElement; el = el.parentElement) next.push(el);
          for (const el of hovered) {
            if (next.includes(el)) continue;
            el.removeAttribute('data-hover');
            el.dispatchEvent(new CustomEvent('hover:leave'));
            if (el instanceof HTMLElement && el.hasAttribute('data-tilt')) untilt(el);
          }
          for (const el of next) {
            if (el.hasAttribute('data-hover')) continue;
            el.setAttribute('data-hover', '');
            el.dispatchEvent(new CustomEvent('hover:enter'));
          }
          hovered = next;
        }
        // Always, even for the same element: the cursor element is new after a page change, and the mouse may
        // just have come back into the window.
        suit(target);
        // The cursor may have moved within the same element, or the element under a still cursor: lean again.
        if (!reduced.matches) for (const el of hovered) if (el instanceof HTMLElement && el.hasAttribute('data-tilt')) tilt(el);
      }

      const onMouse = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse' || !cursor.el) return;
        cursor.x = e.clientX;
        cursor.y = e.clientY;
        cursor.inside = true;
        if (!cursor.seen) {
          cursor.seen = true;
          cursor.sx = cursor.x;
          cursor.sy = cursor.y;
          document.documentElement.classList.add('custom-cursor');
        }
        hover(e.target instanceof Element ? e.target : null);
      };
      document.addEventListener('pointermove', onMouse, { passive: true });
      // Also when the mouse crosses onto something without a move being reported, as when it enters an embedded video.
      document.addEventListener('pointerover', onMouse, { passive: true });

      // What is under the cursor can change while the mouse stands still: the page scrolls, a new page comes in,
      // the image viewer opens or closes, a section folds open, a card tilts away. No mouse event comes then, so
      // look again at what is under the cursor's last place.
      let looking = false;
      function lookAgain() {
        if (looking || !cursor.seen || !cursor.inside) return;
        looking = true;
        requestAnimationFrame(() => {
          looking = false;
          if (!cursor.inside) return;
          const under = document.elementFromPoint(cursor.x, cursor.y);
          // While one page is fading into the next, the browser reports the whole document as what is under the
          // mouse. That says nothing about the new page, so wait: the regular check below will ask again.
          if (under === document.documentElement) return;
          hover(under);
        });
      }
      // (capture: scrolling inside an element, such as a wide table, counts too)
      addEventListener('scroll', lookAgain, { passive: true, capture: true });
      addEventListener('resize', lookAgain);
      addEventListener('focus', lookAgain);
      document.addEventListener('toggle', lookAgain, true); // a fold or the image viewer opening and closing
      document.addEventListener('keyup', lookAgain); // Escape closing the image viewer, arrow keys changing its picture
      document.addEventListener('click', () => requestAnimationFrame(lookAgain)); // whatever the click opened or closed
      // And as a net under all of that, a regular check: cheap, and it catches anything not listed above
      // (a picture that loads and pushes the page down, the end of a page change, an animation).
      setInterval(() => !document.hidden && lookAgain(), 250);

      document.addEventListener('pointerdown', (e) => {
        // A finger on a touch screen has no cursor and no hover: put both away.
        if (e.pointerType !== 'mouse') return leave();
        cursor.el?.classList.add('is-down');
      });
      document.addEventListener('pointerup', () => cursor.el?.classList.remove('is-down'));
      // Leaving the window: nothing is hovered, and our shape hides until the mouse comes back.
      function leave() {
        cursor.inside = false;
        hover(null);
      }
      document.addEventListener('mouseout', (e) => !e.relatedTarget && leave());
      // A page change replaces everything under the cursor: forget the old page before it goes.
      document.addEventListener('astro:before-swap', () => {
        hover(null);
        cursor.el = null;
        document.documentElement.classList.remove('cursor-shape');
      });
      (function follow() {
        requestAnimationFrame(follow);
        if (!cursor.el || !cursor.seen) return;
        // A dialog (the image viewer) opens in the browser's top layer, above the rest of the page,
        // so while one is open the cursor lives inside it.
        const host = document.querySelector('dialog[open]') ?? document.body;
        if (cursor.el.parentElement !== host) host.append(cursor.el);
        // The shape sits where the mouse is: it stands in for the browser's cursor, so it must not lag behind it.
        const k = reduced.matches ? 1 : 0.6;
        cursor.sx += (cursor.x - cursor.sx) * k;
        cursor.sy += (cursor.y - cursor.sy) * k;
        cursor.el.style.transform = `translate3d(${cursor.sx.toFixed(1)}px, ${cursor.sy.toFixed(1)}px, 0)`;
      })();

      // ---------- Sections come up from dark as they enter the screen ([data-rise]) ----------
      function mountReveal() {
        const items = document.querySelectorAll<HTMLElement>('[data-rise]');
        if (!items.length) return;
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              seen.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((item) => seen.observe(item));
      }

      document.addEventListener('astro:page-load', () => {
        mountCursor();
        // A new page is under the cursor: forget the old page's elements and look again (the regular check keeps
        // asking until the new page has finished fading in).
        hovered = [];
        hoverTarget = null;
        suit(null);
        lookAgain();
        mountReveal();

        // Project loops play only while a card is hovered or focused.
        document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
          const video = card.querySelector<HTMLVideoElement>('video[data-hover-play]');
          if (!video) return;
          const play = () => video.play().catch(() => {});
          const stop = () => video.pause();
          // With a mouse, "hover" is the site's own tracking (it also follows scrolling); a touch has no hover,
          // so there the loop plays from the touch itself.
          card.addEventListener('hover:enter', play);
          card.addEventListener('hover:leave', stop);
          card.addEventListener('pointerenter', (e) => e.pointerType !== 'mouse' && play());
          card.addEventListener('pointerleave', (e) => e.pointerType !== 'mouse' && stop());
          card.addEventListener('focusin', play);
          card.addEventListener('focusout', stop);
        });

        // Case-study clips load and play only while they are on screen.
        const clips = document.querySelectorAll<HTMLVideoElement>('video[data-inview-play]');
        if (!clips.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // No motion unless asked for: leave the poster up and offer the player controls.
          clips.forEach((clip) => {
            clip.controls = true;
            clip.removeAttribute('aria-hidden');
          });
          return;
        }
        const onScreen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const clip = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) clip.play().catch(() => {});
              else clip.pause();
            }
          },
          { rootMargin: '200px 0px' },
        );
        clips.forEach((clip) => onScreen.observe(clip));
      });
    </script>
  </body>
</html>
