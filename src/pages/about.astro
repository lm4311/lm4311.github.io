---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import { site, capabilities } from '../data/site';
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <section class="container-x grid gap-12 pt-14 pb-16 sm:pt-20 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
    <div>
      <h1 class="font-display text-4xl sm:text-6xl">About me</h1>
      <div class="mt-8 max-w-2xl space-y-5 text-lg leading-8 text-ink/85">
        <p>
          Write two or three short paragraphs. Start with who you are and what you build: VR showrooms, shared XR
          experiences, visualization and motion capture.
        </p>
        <p>
          Then what makes you different: you design and you develop, so you can take an idea from concept to a
          working experience. End with what you're looking for next.
        </p>
      </div>
      <h2 class="mt-12 text-sm font-semibold">Main capabilities</h2>
      <ul class="mt-4 space-y-2.5 text-[17px] text-ink/85">
        {
          capabilities.map((c) => (
            <li class="flex gap-3">
              <span class="mt-3 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={`mailto:${site.email}`} class="btn-solid">{site.email}</a>
        <a href={site.links.linkedin} class="btn">LinkedIn</a>
        <a href={site.resume} class="btn">Résumé (PDF)</a>
      </div>
    </div>
    <!-- Swap for a portrait: put it in public/ and pass poster="/me.jpg". -->
    <figure>
      <Cover seed="portrait" accent="#62e6d3" motif="portal" alt={site.name} class="aspect-[4/5] rounded-2xl border border-line" />
      <figcaption class="mt-3 text-sm text-muted">Portrait placeholder</figcaption>
    </figure>
  </section>

  <section class="container-x border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl">Experience</h2>
    <div class="mt-10"><Experience /></div>
  </section>

  <section class="container-x border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl">Skills</h2>
    <div class="mt-10"><Skills /></div>
  </section>
</Base>
