---
import Base from '../layouts/Base.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Video from '../components/Video.astro';
import { getProjects } from '../lib/work';
import { site, about, capabilities, interview } from '../data/site';

// The text lives in src/data/site.ts. A project's title in it becomes a link to that project's page.
const projects = (await getProjects()).filter((p) => !p.data.inDevelopment);
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const paragraphs = about.map((text) =>
  projects.reduce(
    (html, p) =>
      html.replace(
        escape(p.data.title),
        `<a href="/work/${p.id}/" class="text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink">${escape(p.data.title)}</a>`,
      ),
    escape(text),
  ),
);
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <!-- Text on the left; the portrait (when there is one), capabilities and contact on the right. -->
  <section class="container-x grid gap-12 pt-14 pb-16 sm:pt-20 lg:grid-cols-[1.35fr_1fr] lg:gap-20">
    <div>
      <h1 class="font-display text-4xl sm:text-6xl">About me</h1>
      <div class="mt-8 max-w-2xl space-y-5 text-lg leading-8 text-ink/85">
        {paragraphs.map((html) => <p set:html={html} />)}
      </div>
    </div>
    <aside class:list={[!site.portrait && 'lg:pt-[6.5rem]']}>
      {
        site.portrait && (
          <div class="portrait-3d mb-10 max-w-md" data-tilt>
            <!-- A portrait with depth: the card stays still and the person moves. See "The portrait" in global.css. -->
            <div class="portrait-stage">
              {site.portraitSubject && site.portraitBackdrop ? (
                <div class="portrait-window">
                  <img class="portrait-back" src={site.portraitBackdrop} alt="" width="800" height="800" />
                  <img class="portrait-subject" src={site.portraitSubject} alt={`Portrait of ${site.name}`} width="800" height="800" />
                </div>
              ) : (
                <div class="portrait-window">
                  <img src={site.portrait} alt={`Portrait of ${site.name}`} width="800" height="800" />
                </div>
              )}
              <p class="portrait-tag rounded-full border border-line bg-bg/85 px-3.5 py-1.5 text-xs font-medium shadow-[0_14px_30px_-12px_rgb(0_0_0/0.9)]">
                {site.name} <span class="text-muted">· {site.location}</span>
              </p>
            </div>
          </div>
        )
      }
      <h2 class="label">Main capabilities</h2>
      <ul class="mt-4 space-y-2.5 text-[17px] text-ink/85">
        {
          capabilities.map((c) => (
            <li class="flex gap-3">
              <span class="mt-3 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
              {c}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap gap-3">
        {site.email && <a href={`mailto:${site.email}`} class="btn-solid">{site.email}</a>}
        {site.links.linkedin && <a href={site.links.linkedin} class="btn">LinkedIn</a>}
        {site.resume && <a href={site.resume} class="btn">Résumé (PDF)</a>}
      </div>
    </aside>
  </section>

  <!-- The ASUS interview (a vertical Instagram reel), hosted here with a link to the original post. -->
  <section id="interview" class="container-x scroll-mt-20 border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl" data-rise>Interview</h2>
    <div class="mt-10 grid items-center gap-10 sm:grid-cols-[minmax(0,20rem)_1fr] sm:gap-14 lg:gap-20" data-rise>
      <div class="max-w-xs sm:max-w-none">
        <Video
          src="/media/asus-interview/when-details-matter.mp4"
          poster="/media/asus-interview/when-details-matter.webp"
          ratio="9 / 16"
          title="When Details Matter, an interview by ASUS USA"
          class=""
        />
        <a
          href={interview.url}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-block text-sm text-muted underline decoration-ink/30 underline-offset-4 hover:text-ink hover:decoration-ink"
        >
          Watch the original reel on Instagram ↗
        </a>
      </div>
      <div class="max-w-xl">
        <p class="label">{interview.source} · {interview.date}</p>
        <h3 class="mt-3 font-display text-2xl sm:text-3xl">{interview.title}</h3>
        <p class="mt-5 text-lg leading-8 text-ink/85">{interview.text}</p>
      </div>
    </div>
  </section>

  <section class="container-x border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl" data-rise>Experience</h2>
    <div class="mt-10" data-rise><Experience /></div>
  </section>

  <section class="container-x border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl" data-rise>Skills</h2>
    <div class="mt-10" data-rise><Skills /></div>
  </section>
</Base>
