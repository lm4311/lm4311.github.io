---
// Project page: experience first, project overview, then the story
// (contribution, key decisions, results) from the MDX file, then credits.
//
// Reading aids: a progress line under the navigation bar, a contents rail beside the text on wide screens
// (a fold-out list on smaller ones), and section headings and media that come up from dark as they are reached.
// The styles are under "Project pages" in global.css.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Frame from '../../components/Frame.astro';
import FrameRow from '../../components/FrameRow.astro';
import YouTube from '../../components/YouTube.astro';
import Video from '../../components/Video.astro';
import Clips from '../../components/Clips.astro';
import Boards from '../../components/Boards.astro';
import Reveal from '../../components/Reveal.astro';
import Folds from '../../components/Folds.astro';
import Compare from '../../components/Compare.astro';
import Pipeline from '../../components/Pipeline.astro';
import Stats from '../../components/Stats.astro';
import Laurel from '../../components/Laurel.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/work';
import { groupLabel } from '../../data/site';

export async function getStaticPaths() {
  // Projects still in development have a card on the homepage but no page of their own.
  const projects = (await getProjects()).filter((p) => !p.data.inDevelopment);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;

// The contents list: every main section, each with its sub-sections.
type Section = { slug: string; text: string; subs: { slug: string; text: string }[] };
const sections: Section[] = [];
for (const h of headings) {
  if (h.depth === 2) sections.push({ slug: h.slug, text: h.text, subs: [] });
  else if (h.depth === 3 && sections.length) sections[sections.length - 1].subs.push({ slug: h.slug, text: h.text });
}
const hasContents = sections.length >= 3;

const specs = [
  { label: 'My role', value: d.role },
  { label: 'Team', value: d.team },
  // The year is added only when the timeframe doesn't already name one ("September 2024 to present" stands as it is).
  { label: 'Timeframe', value: d.duration ? (/\b(19|20)\d\d\b/.test(d.duration) ? d.duration : `${d.duration} · ${d.year}`) : String(d.year) },
  { label: 'Platform', value: d.platform },
  { label: 'Client', value: d.client },
].filter((m) => m.value);
const links = [
  { label: 'Read the technical manual', href: d.links?.docs },
  { label: 'Watch full video', href: d.links?.video },
  { label: 'Try the demo', href: d.links?.demo },
  { label: 'Source code', href: d.links?.code },
].filter((l): l is { label: string; href: string } => !!l.href);
---

<Base title={d.title} description={d.summary}>
  <article style={`--color-accent: ${d.accent}`} data-project>
    <!-- How far through the page the reader is. -->
    <div class="read-progress" data-read-progress aria-hidden="true"></div>

    <header class="container-x pt-10 sm:pt-14">
      <a href="/#work" class="text-sm text-muted hover:text-ink">← All work</a>
      {
        d.placeholder && (
          <p class="mt-6 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-ink/80">
            Sample content. Replace the text and placeholder images with your own.
          </p>
        )
      }
      <!-- With an award, its laurel sits to the right of the title block (below it on a phone). -->
      <div class="md:flex md:items-end md:justify-between md:gap-10">
        <div class="min-w-0">
          <p class="label mt-8">{groupLabel[d.category]} · {d.year}</p>
          <h1 class="font-display mt-3 max-w-5xl text-[clamp(2.5rem,6vw,4.75rem)]">{d.title}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-ink/80 sm:text-xl sm:leading-9">{d.summary}</p>
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tags">
            {d.tags.map((t) => <li class="rounded-full bg-surface px-2.5 py-1 text-xs text-ink/80">{t}</li>)}
          </ul>
        </div>
        {d.award && <Laurel {...d.award} class="mt-8 w-40 shrink-0 text-ink/90 md:mt-0 md:w-52" />}
      </div>
    </header>

    <!-- Experience first. The homepage card's picture grows into this media when the project is opened,
         and the media leans back a little as the reader scrolls past it. -->
    <div class="container-x mt-10">
      <div class="hero-media" data-recede>
        <div transition:name={`cover-${project.id}`}>
          {
            d.youtube ? (
              <YouTube id={d.youtube} title={d.title} />
            ) : d.film ? (
              <Video src={d.film.src} poster={d.film.poster} ratio={d.film.ratio} title={d.title} class="" />
            ) : (
              <Cover
                seed={d.title}
                accent={d.accent}
                motif={d.motif}
                video={d.video}
                poster={d.poster}
                alt={d.title}
                autoplay
                controls
                class="aspect-video rounded-2xl border border-line"
              />
            )
          }
        </div>
      </div>
      {
        links.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-3">
            {links.map((l) => (
              <a href={l.href} class="btn" target="_blank" rel="noopener">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }
      {d.links?.demoNote && <p class="mt-3 text-sm text-muted">{d.links.demoNote}</p>}
    </div>

    <!-- Project overview: what it is for, in large type, beside a short spec sheet. -->
    <section class="container-x mt-16 sm:mt-20" aria-labelledby="overview">
      <h2 id="overview" class="sr-only">Project overview</h2>
      <div class="grid gap-10 border-t border-line pt-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-20">
        <div>
          {
            d.purpose && (
              <>
                <p class="label">Purpose</p>
                <p class="mt-3 max-w-2xl text-xl leading-8 text-ink sm:text-2xl sm:leading-9">{d.purpose}</p>
              </>
            )
          }
          {
            d.audience && (
              <>
                <p class="label mt-8">Audience</p>
                <p class="mt-2 max-w-2xl leading-7 text-ink/80">{d.audience}</p>
              </>
            )
          }
        </div>
        <dl class="spec-sheet">
          {
            specs.map((m) => (
              <div>
                <dt class="label">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Contribution, key decisions, results and learning -->
    <div class:list={['container-x py-14 sm:py-20', hasContents && 'project-body']}>
      {
        hasContents && (
          <aside class="contents-rail" aria-label="On this page">
            <p class="label">On this page</p>
            <ol data-contents>
              {sections.map((s) => (
                <li>
                  <a href={`#${s.slug}`}>{s.text}</a>
                  {s.subs.length > 0 && (
                    <ol>
                      {s.subs.map((sub) => (
                        <li>
                          <a href={`#${sub.slug}`}>{sub.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="min-w-0">
        {
          hasContents && (
            <details class="contents-fold">
              <summary>
                <span class="label text-ink">On this page</span>
                <span class="text-muted" aria-hidden="true">
                  +
                </span>
              </summary>
              <ol>
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.slug}`}>{s.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <!-- The container lets galleries inside the text column span the full column width (100cqw). -->
        <div class="@container">
          <div class="prose" data-prose>
            <Content components={{ Frame, FrameRow, Compare, Pipeline, Stats, YouTube, Video, Clips, Boards, Reveal, Folds }} />
          </div>
        </div>
      </div>
    </div>

    <!-- Credits -->
    {
      (d.credits?.length || d.tools.length > 0) && (
        <section class="container-x pb-16 sm:pb-20" aria-labelledby="credits">
          <div class="grid gap-10 border-t border-line pt-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
            <h2 id="credits" class="font-display text-2xl sm:text-3xl">Credits</h2>
            <div class="grid gap-10 sm:grid-cols-2">
              {d.credits && d.credits.length > 0 && (
                <div>
                  <h3 class="label">Collaborators</h3>
                  <ul class="mt-4 divide-y divide-line border-y border-line">
                    {d.credits.map((c) => (
                      <li class="py-3">
                        <p class="font-medium">{c.name}</p>
                        <p class="mt-0.5 text-[15px] leading-6 text-ink/70">{c.role}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {d.tools.length > 0 && (
                <div>
                  <h3 class="label">Tools</h3>
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {d.tools.map((t) => (
                      <li class="rounded-full border border-line px-3 py-1 text-sm text-ink/80">{t}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <!-- More projects: the same 3D cards as the homepage. -->
  <nav class="container-x border-t border-line py-14 sm:py-20" aria-label="More projects">
    <div class="grid gap-x-10 gap-y-14 md:grid-cols-2">
      <div>
        <p class="label mb-5">← Previous project</p>
        <ProjectCard project={prev} morph={false} />
      </div>
      <div>
        <p class="label mb-5 md:text-right">Next project →</p>
        <ProjectCard project={next} morph={false} />
      </div>
    </div>
  </nav>
</Base>

<script>
  // Scroll behaviour for project pages: the progress line, the contents rail's current section,
  // the top media leaning back as it leaves, and sections coming up from dark as they are reached.
  let cleanup: (() => void) | null = null;

  function mount() {
    cleanup?.();
    cleanup = null;
    const article = document.querySelector<HTMLElement>('[data-project]');
    if (!article) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const progress = article.querySelector<HTMLElement>('[data-read-progress]');
    const recede = article.querySelector<HTMLElement>('[data-recede]');
    const prose = article.querySelector<HTMLElement>('[data-prose]');
    const rail = article.querySelector<HTMLElement>('[data-contents]');
    const railLinks = rail ? [...rail.querySelectorAll<HTMLAnchorElement>('a')] : [];
    const targets = railLinks
      .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => !!t.el);

    // Headings and media below the first screen start dark and come up as they are reached.
    const rising: HTMLElement[] = [];
    if (prose && !reduced) {
      for (const el of prose.querySelectorAll<HTMLElement>(':scope > h2, :scope > figure, :scope > div, :scope > dl')) {
        if (el.getBoundingClientRect().top > innerHeight * 0.92) {
          el.setAttribute('data-rise', '');
          rising.push(el);
        }
      }
    }
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -6% 0px' },
    );
    rising.forEach((el) => seen.observe(el));

    let ticking = false;
    const update = () => {
      ticking = false;
      const top = article.getBoundingClientRect().top + scrollY;
      const span = article.offsetHeight - innerHeight;
      const done = span > 0 ? Math.min(1, Math.max(0, (scrollY - top) / span)) : 0;
      progress?.style.setProperty('--read', done.toFixed(4));

      if (recede && !reduced) {
        const r = recede.getBoundingClientRect();
        // 0 while the media is fully below the navigation bar, 1 once it has scrolled out.
        const gone = Math.min(1, Math.max(0, (72 - r.top) / (r.height * 0.9)));
        recede.style.setProperty('--recede', gone.toFixed(3));
      }

      // The current section is the last heading that has passed the top quarter of the screen.
      let current: HTMLAnchorElement | null = null;
      for (const t of targets) if (t.el.getBoundingClientRect().top <= innerHeight * 0.28) current = t.a;
      for (const a of railLinks) {
        const on = a === current;
        a.classList.toggle('is-current', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
      // Open the sub-list of the section being read.
      rail?.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => li.classList.toggle('is-open', !!current && li.contains(current)));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();

    cleanup = () => {
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onScroll);
      seen.disconnect();
    };
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
