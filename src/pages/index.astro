---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroField from '../components/HeroField.astro';
import { getProjects } from '../lib/work';
import { site, homeAbout, capabilities, groupLabel } from '../data/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
// Mocap projects get their own section unless they've been promoted to featured.
const mocap = projects.filter((p) => p.data.category === 'mocap' && !p.data.featured);
const games = projects.filter((p) => p.data.category === 'games' && !p.data.featured);
---

<Base>
  <!-- Opening section: who you are, over an interactive spatial floor. -->
  <section class="relative overflow-hidden" data-hero-field>
    <HeroField />
    <!-- Keeps the copy readable over the points. -->
    <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-bg/90 from-5% via-bg/45 via-40% to-transparent to-75%"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-bg to-transparent"></div>
    <div class="container-x relative flex min-h-[calc(100svh-4rem)] flex-col justify-center py-20" data-hero-copy>
      <p class="text-sm text-muted">Based in {site.location}</p>
      <h1 class="font-display mt-4 text-[clamp(3.75rem,12vw,10.5rem)] leading-[0.9] tracking-[-0.045em]">{site.name}</h1>
      <p class="font-display mt-6 text-2xl text-accent sm:text-4xl">{site.role}</p>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-ink/80 sm:text-xl sm:leading-9">{site.intro}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#work" class="btn-solid">View work <span aria-hidden="true">↓</span></a>
        {site.resume && <a href={site.resume} class="btn">Résumé</a>}
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section id="work" class="container-x scroll-mt-20 border-t border-line py-16 sm:py-20">
    <h2 class="font-display text-3xl sm:text-4xl">Featured work</h2>
    <div class="mt-10 grid gap-x-10 gap-y-16 md:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Motion capture work -->
  {
    mocap.length > 0 && (
      <section id="mocap" class="container-x scroll-mt-20 border-t border-line py-16 sm:py-20">
        <h2 class="font-display text-3xl sm:text-4xl">{groupLabel.mocap}</h2>
        <div class="mt-10 grid gap-x-10 gap-y-16 md:grid-cols-2">
          {mocap.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Games -->
  {
    games.length > 0 && (
      <section id="games" class="container-x scroll-mt-20 border-t border-line py-16 sm:py-20">
        <h2 class="font-display text-3xl sm:text-4xl">{groupLabel.games}</h2>
        <div class="mt-10 grid gap-x-10 gap-y-16 md:grid-cols-2">
          {games.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Brief introduction and contact -->
  <section id="contact" class="container-x scroll-mt-20 border-t border-line py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl">About me</h2>
        <p class="mt-5 max-w-xl text-lg leading-8 text-ink/85">{homeAbout}</p>
        <a href="/about/" class="mt-5 inline-block text-sm text-ink/70 underline underline-offset-4 hover:text-ink">More about me</a>
      </div>
      <div>
        <h3 class="text-sm font-semibold">Main capabilities</h3>
        <ul class="mt-4 space-y-2.5 text-[17px] text-ink/85">
          {
            capabilities.map((c) => (
              <li class="flex gap-3">
                <span class="mt-3 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="mt-14 flex flex-wrap gap-3 border-t border-line pt-10">
      {site.email && <a href={`mailto:${site.email}`} class="btn-solid">{site.email}</a>}
      {site.links.linkedin && <a href={site.links.linkedin} class="btn">LinkedIn</a>}
      {site.resume && <a href={site.resume} class="btn">Résumé (PDF)</a>}
    </div>
  </section>
</Base>
